# Seedit Archive server config. Copy to .env (gitignored) on the VPS — see DEPLOY.md.

# The co-located bitsocial-cli daemon's PKC RPC endpoint, including its auth token.
# SECRET — never commit this, never copy it off the VPS. The container uses
# host networking, so localhost here really is the VPS host.
PKC_RPC_URL=ws://localhost:9138/REPLACE_WITH_DAEMON_AUTH_TOKEN

# Public URL of the web UI (used for sitemap / canonical links).
SITE_URL=https://seeditarchive.org

# Browser origins allowed to call the API. Seedit is included now so the later
# in-app search integration can consume the same read-only API without a server change.
ALLOWED_ORIGINS=https://seeditarchive.org,https://seedit.app

# Re-crawl cadence (ms) and pagination depth per pass.
CRAWL_INTERVAL_MS=300000
CRAWL_MAX_PAGES=20
