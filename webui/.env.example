# Where the UI reads the indexer API from (server-side fetch).
INDEXER_API=http://localhost:4000

# Instance branding: SITE_NAME is used in page titles, metadata, the sidebar and
# the footer; a non-empty SITE_BADGE is appended to it in titles and OpenGraph.
SITE_NAME=Bitsocial
SITE_BADGE=Indexer

# Public origin of THIS web UI (no trailing slash) — used for canonical URLs,
# OpenGraph tags, robots.txt and the sitemap index. E.g. https://seeditarchive.org
SITE_URL=http://localhost:3000

# Optional footer attribution, e.g. BRAND_TEXT="A Bitsocial Forge product".
# Nothing is rendered unless BRAND_TEXT is set; BRAND_URL makes it a link.
BRAND_TEXT=
BRAND_URL=

# Contact address for content-removal / takedown requests, shown on /legal.
# Unset = the page says requests are handled by the instance operator.
CONTACT_EMAIL=
